# Demo-only configuration. Copy to .env and change EVERY password. Never commit .env.

# --- Databases (separate credentials for each) ---
POSTGRES_APP_DB=ib_app
POSTGRES_APP_USER=ib_app
POSTGRES_APP_PASSWORD=change_me_app
POSTGRES_FINERACT_DB=fineract_tenants
POSTGRES_FINERACT_USER=fineract
POSTGRES_FINERACT_PASSWORD=change_me_fineract

# --- Apache Fineract ---
# Pin a tested release and confirm it exists on Docker Hub before first start.
FINERACT_IMAGE_TAG=1.12.1
FINERACT_BASE_URL=http://fineract:8443
FINERACT_TENANT_ID=default
# Fineract ships with mifos/password. It is not published to the host, but change it in
# Fineract after first start and update these two values to match.
FINERACT_USERNAME=mifos
FINERACT_PASSWORD=password

# --- Internet Banking application ---
SPRING_PROFILES_ACTIVE=dev
# Replace this placeholder. Generate a unique value with: openssl rand -base64 32
APP_JWT_SECRET=CHANGE-ME-Use-A-Unique-Secret-At-Least-32-Bytes
# Optional, comma-separated exact browser origins allowed to call the API.
APP_CORS_ALLOWED_ORIGINS=
# First admin, created on startup if missing. Min 12 chars with upper, lower, digit and symbol.
APP_BOOTSTRAP_ADMIN_USERNAME=admin
APP_BOOTSTRAP_ADMIN_PASSWORD=CHANGE-ME-Admin#2026
# Optional demo logins: bank.user1 (Bank User) and customer.alex (Customer), same password.
# Set APP_SEED_DEMO_USERS=false for a clean install. Password rules as above.
APP_SEED_DEMO_USERS=true
DEMO_USER_PASSWORD=CHANGE-ME-Demo#2026
